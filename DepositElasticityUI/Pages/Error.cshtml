@page
@model DepositElasticity.Pages.ErrorModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Error";
}

<div class="login-page">
    <div class="login-shell">
        <div class="login-brand">
            @await Html.PartialAsync("_BrandMark")
        </div>
        <div class="login-card">
            <h1>Something went wrong</h1>
            <p class="login-sub">
                @if (Model.ShowRequestId)
                {
                    <span>Request ID: <code>@Model.RequestId</code></span>
                }
                else
                {
                    <span>An unexpected error occurred. Try again, or contact the desk if it persists.</span>
                }
            </p>
            <a class="login-btn" style="display:block;text-align:center;text-decoration:none;" href="/Login">Back to sign in</a>
        </div>
    </div>
</div>
