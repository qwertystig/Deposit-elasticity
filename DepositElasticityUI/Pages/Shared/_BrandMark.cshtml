@{
    // Real Barclays logo assets (uploaded). "full" shows the complete
    // eagle+wordmark lockup (used where there's room — rail header, login);
    // "icon" shows just the eagle glyph (used for compact spots like the
    // empty-state icon, where the full wordmark won't fit).
    var variant = ViewData["Variant"] as string ?? "full";
    var showCaption = ViewData["ShowTitle"] as bool? ?? true;
}
@if (variant == "icon")
{
    <img src="~/images/barclays-icon.png" alt="Barclays" class="bde-mark-icon-only" />
}
else
{
    <div class="bde-mark">
        <img src="~/images/barclays-logo.png" alt="Barclays" class="bde-mark-logo" />
        @if (showCaption)
        {
            <div class="bde-mark-caption">Deposit Elasticity Console</div>
        }
    </div>
}
